# IntelForge - Environment Variables
# Copy this file to .env.local in your project root

# =============================================================================
# Application Configuration
# =============================================================================
NEXT_PUBLIC_APP_NAME="IntelForge"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# =============================================================================
# Database Configuration (for future backend integration)
# =============================================================================
# PostgreSQL
DATABASE_URL="postgresql://username:password@localhost:5432/intelforge"
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Supabase (Alternative)
NEXT_PUBLIC_SUPABASE_URL="https://nsidntzsgbzooexrvnti.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5zaWRudHpzZ2J6b29leHJ2bnRpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjM5OTkxODgsImV4cCI6MjA3OTU3NTE4OH0.15lX9QQX8eoIahRBG9inrWmf6vZoI3TDumqSnusb7fA"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im5zaWRudHpzZ2J6b29leHJ2bnRpIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc2Mzk5OTE4OCwiZXhwIjoyMDc5NTc1MTg4fQ.Y3Qd96N6yzb7g1xBm28SGLeLx5KeJsuiVRInJ93BPkY"

# =============================================================================
# AI/ML API Keys
# =============================================================================
# OpenAI (for LLM-based features)
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4-turbo-preview"

# Anthropic Claude (for analysis features)
ANTHROPIC_API_KEY="sk-ant-your-anthropic-api-key"
ANTHROPIC_MODEL="claude-3-sonnet-20240229"

# Google AI (for Gemini)
GOOGLE_AI_API_KEY="your-google-ai-api-key"

# =============================================================================
# CrewAI Configuration (for autonomous agents)
# =============================================================================
CREWAI_API_KEY="your-crewai-api-key"
CREWAI_TELEMETRY_DISABLED="true"

# =============================================================================
# Data Sources & APIs
# =============================================================================
# Patent Databases
USPTO_API_KEY="your-uspto-api-key"
EPO_API_KEY="your-epo-api-key"

# Academic Databases
ARXIV_API_KEY="not-required-but-rate-limited"
IEEE_API_KEY="your-ieee-api-key"
SEMANTIC_SCHOLAR_API_KEY="your-semantic-scholar-api-key"

# Funding & Business Data
CRUNCHBASE_API_KEY="your-crunchbase-api-key"
PITCHBOOK_API_KEY="your-pitchbook-api-key"

# News & Media
NEWS_API_KEY="your-newsapi-key"
GOOGLE_NEWS_API_KEY="your-google-news-api-key"

# =============================================================================
# Search & Scraping
# =============================================================================
# SerpAPI (for Google search results)
SERP_API_KEY="your-serpapi-key"

# ScraperAPI (for web scraping)
SCRAPER_API_KEY="your-scraperapi-key"

# Bright Data (Alternative scraping)
BRIGHT_DATA_USERNAME="your-bright-data-username"
BRIGHT_DATA_PASSWORD="your-bright-data-password"

# =============================================================================
# Authentication (for future user management)
# =============================================================================
# NextAuth.js
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"

GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# =============================================================================
# Email Configuration
# =============================================================================
# SMTP Settings (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
SMTP_FROM="noreply@intelforge.com"

# SendGrid (Alternative)
SENDGRID_API_KEY="your-sendgrid-api-key"

# =============================================================================
# Cloud Storage (for file uploads)
# =============================================================================
# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="intelforge-uploads"

# Cloudinary (Alternative)
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# =============================================================================
# Redis (for caching & rate limiting)
# =============================================================================
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"

# Upstash Redis (Serverless alternative)
UPSTASH_REDIS_URL="your-upstash-redis-url"
UPSTASH_REDIS_TOKEN="your-upstash-redis-token"

# =============================================================================
# Analytics & Monitoring
# =============================================================================
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Posthog (Product analytics)
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-project-api-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# Sentry (Error tracking)
SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# =============================================================================
# Collaboration & Notifications
# =============================================================================
# Slack
SLACK_BOT_TOKEN="xoxb-your-slack-bot-token"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
SLACK_CHANNEL="#intelforge-alerts"

# Discord
DISCORD_WEBHOOK_URL="your-discord-webhook-url"

# =============================================================================
# Payment Processing (for future premium features)
# =============================================================================
# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_test_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-stripe-webhook-secret"

# =============================================================================
# ML Model Serving
# =============================================================================
# Hugging Face
HUGGINGFACE_API_KEY="your-huggingface-api-key"

# Replicate (for running ML models)
REPLICATE_API_TOKEN="your-replicate-api-token"

# =============================================================================
# Feature Flags
# =============================================================================
NEXT_PUBLIC_ENABLE_AUTH="false"
NEXT_PUBLIC_ENABLE_ANALYTICS="true"
NEXT_PUBLIC_ENABLE_AI_FEATURES="true"
NEXT_PUBLIC_ENABLE_EXPORT="true"
NEXT_PUBLIC_ENABLE_COLLABORATION="false"

# =============================================================================
# Development Tools
# =============================================================================
# Logging
LOG_LEVEL="debug"
ENABLE_QUERY_LOGGING="true"

# Rate Limiting
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_MAX_REQUESTS="100"
RATE_LIMIT_WINDOW_MS="900000"

# =============================================================================
# Hackathon/Demo Settings
# =============================================================================
# Use mock data (set to "true" for demo without real APIs)
NEXT_PUBLIC_USE_MOCK_DATA="true"

# Demo mode features
NEXT_PUBLIC_DEMO_MODE="true"
NEXT_PUBLIC_SHOW_ONBOARDING="true"

# =============================================================================
# Security
# =============================================================================
# JWT Secret (for API authentication)
JWT_SECRET="your-jwt-secret-generate-with-openssl-rand-base64-32"
JWT_EXPIRES_IN="7d"

# API Rate Limiting
API_RATE_LIMIT="100"
API_RATE_LIMIT_WINDOW="15m"

# CORS Settings
ALLOWED_ORIGINS="http://localhost:3000,https://yourdomain.com"

# =============================================================================
# NOTES
# =============================================================================
# 1. Never commit this file to git (it's in .gitignore)
# 2. For production, use your platform's environment variable settings
# 3. Generate secrets using: openssl rand -base64 32
# 4. Keep all API keys secure and rotate them regularly
# 5. For local development, most APIs can use mock data
# 6. Set NEXT_PUBLIC_USE_MOCK_DATA="true" to use mock data without APIs
